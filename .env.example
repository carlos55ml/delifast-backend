# Copia este fichero a .env (no se sube a git) y rellénalo con los datos del proyecto
# Supabase delifast-dev. Panel de Supabase → botón "Connect" → "Session pooler".

# Base de datos (Session pooler, puerto 5432)
DB_URL=jdbc:postgresql://aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
DB_USER=postgres.<project-ref>
DB_PASSWORD=<contraseña de la base de datos>

# Supabase (Project Settings → API). La URL sirve para validar los JWT (JWKS) y la
# service_role para crear cuentas con la Admin API de Auth.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Opcional: por defecto ${SUPABASE_URL}/auth/v1/.well-known/jwks.json
# SUPABASE_JWKS_URL=

# API
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Enlace de los emails de invitación (añadirlo en Supabase → Authentication → URL Configuration → Redirect URLs)
URL_INVITACION=http://localhost:3000/auth/confirmar?siguiente=/nueva-contrasena
