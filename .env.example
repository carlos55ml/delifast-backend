# Copia este fichero a .env (no se sube a git) y rellénalo con los datos del proyecto
# Supabase delifast-dev. Panel de Supabase → botón "Connect" → "Session pooler".

# Base de datos (Session pooler, puerto 5432)
DB_URL=jdbc:postgresql://aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
DB_USER=postgres.<project-ref>
DB_PASSWORD=<contraseña de la base de datos>

# Supabase (Project Settings → API). Se usarán al conectar Auth y Storage.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# API
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:3000
